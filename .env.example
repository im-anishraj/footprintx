# FootprintX Environment Variables
# Copy to .env and fill in values
# NEVER commit .env — only .env.example

# ─── Application ──────────────────────────────────────────────────
# development | production | test
APP_ENV=development

# Origin of the web app (for CORS, CSRF, links in emails)
WEB_ORIGIN=http://localhost:3000

# API base URL (used by web app)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://footprintx:footprintx@localhost:5432/footprintx

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
# HMAC key for email hashing — changing this invalidates all abuse counters
SERVER_PEPPER=CHANGE_ME_generate_with_secrets_token_hex_32

# Master encryption key for scan results (hex-encoded 32 bytes)
MASTER_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# Session signing secret
SESSION_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32

# ─── Scanner ──────────────────────────────────────────────────────
# mock | live
# mock: returns deterministic fixture data (default for development)
# live: makes real requests to third-party services
SCANNER_MODE=mock

# Scanner encryption key for queue payloads (hex-encoded 32 bytes)
SCANNER_QUEUE_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# Max concurrent scanner modules (default 8)
SCANNER_CONCURRENCY=8

# Per-module timeout in seconds (default 10)
SCANNER_MODULE_TIMEOUT=10

# Global scan timeout in seconds (default 60)
SCANNER_GLOBAL_TIMEOUT=60

# ─── Have I Been Pwned ───────────────────────────────────────────
# API key from https://haveibeenpwned.com/API/Key
# Leave empty to disable breach checking (graceful degradation)
HIBP_API_KEY=

# ─── Cloudflare Turnstile ────────────────────────────────────────
# Test keys (always pass): https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Email ────────────────────────────────────────────────────────
# resend | smtp
EMAIL_PROVIDER=smtp

# Resend API (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# From address for outgoing emails
EMAIL_FROM=verify@footprintx.local

# ─── Sentry (optional) ───────────────────────────────────────────
# Leave empty to disable
SENTRY_DSN=

# ─── Analytics (optional) ────────────────────────────────────────
# Set to enable privacy-friendly analytics (e.g., plausible URL)
ANALYTICS_URL=

# ─── Canary Testing ──────────────────────────────────────────────
# Path to JSON file mapping module names to test accounts
# Format: { "github": { "registered": "test@example.com", "unregistered": "noone@example.com" } }
CANARY_CONFIG=

# ─── Consent ──────────────────────────────────────────────────────
CONSENT_VERSION=1.0.0
